diff --git a/includes/save-handler.php b/includes/save-handler.php
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/includes/save-handler.php
@@ -0,0 +1,65 @@
+<?php
+if (!defined('ABSPATH')) {
+    exit;
+}
+
+function kc_save_recipe_ingredients($post_id, $post, $update) {
+    // Перевірка автозбереження
+    if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) {
+        return;
+    }
+    
+    // Перевірка прав доступу
+    if (!current_user_can('edit_post', $post_id)) {
+        return;
+    }
+    
+    // Перевірка типу поста (припустимо, що рецепти - це пости типу 'recipe')
+    if ($post->post_type !== 'post' && $post->post_type !== 'recipe') {
+        return;
+    }
+    
+    // Отримуємо блоки з поста
+    $blocks = parse_blocks($post->post_content);
+    
+    $ingredients_data = array();
+    
+    foreach ($blocks as $block) {
+        if ($block['blockName'] === 'kc/recipe-ingredients') {
+            // Парсимо дані з блоку інгредієнтів
+            $ingredients_data = kc_parse_ingredients_block($block);
+            break;
+        }
+    }
+    
+    // Зберігаємо дані в базу
+    if (!empty($ingredients_data)) {
+        kc_save_recipe_ingredients_data($post_id, $ingredients_data);
+    }
+}
+
+function kc_parse_ingredients_block($block) {
+    $ingredients_data = array();
+    
+    // Припустимо, що блок містить список інгредієнтів
+    // Це потрібно буде адаптувати залежно від структури блоку
+    if (isset($block['attrs']['ingredients'])) {
+        foreach ($block['attrs']['ingredients'] as $ingredient) {
+            // Шукаємо інгредієнт по slug
+            $ingredient_post = get_page_by_path($ingredient['slug'], OBJECT, 'ingredient');
+            
+            if ($ingredient_post) {
+                $ingredients_data[] = array(
+                    'ingredient_id' => $ingredient_post->ID,
+                    'amount' => floatval($ingredient['amount']),
+                    'unit_text' => sanitize_text_field($ingredient['unit'])
+                );
+            }
+        }
+    }
+    
+    return $ingredients_data;
+}
diff --git a/assets/js/blocks.js b/assets/js/blocks.js
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/assets/js/blocks.js
@@ -0,0 +1,150 @@
+(function(wp) {
+    var el = wp.element.createElement;
+    var registerBlockType = wp.blocks.registerBlockType;
+    var RichText = wp.blockEditor.RichText;
+    var InspectorControls = wp.blockEditor.InspectorControls;
+    var PanelBody = wp.components.PanelBody;
+    var TextControl = wp.components.TextControl;
+    var Button = wp.components.Button;
+    
+    // Блок інгредієнтів
+    registerBlockType('kc/recipe-ingredients', {
+        title: 'Recipe Ingredients',
+        icon: 'carrot',
+        category: 'widgets',
+        attributes: {
+            ingredients: {
+                type: 'array',
+                default: []
+            }
+        },
+        edit: function(props) {
+            var ingredients = props.attributes.ingredients || [];
+            
+            function addIngredient() {
+                var newIngredients = [...ingredients];
+                newIngredients.push({
+                    slug: '',
+                    amount: 1,
+                    unit: 'шт'
+                });
+                props.setAttributes({ ingredients: newIngredients });
+            }
+            
+            function updateIngredient(index, field, value) {
+                var newIngredients = [...ingredients];
+                newIngredients[index][field] = value;
+                props.setAttributes({ ingredients: newIngredients });
+            }
+            
+            function removeIngredient(index) {
+                var newIngredients = [...ingredients];
+                newIngredients.splice(index, 1);
+                props.setAttributes({ ingredients: newIngredients });
+            }
+            
+            return el('div', { className: props.className },
+                el('h3', {}, 'Recipe Ingredients'),
+                ingredients.map(function(ingredient, index) {
+                    return el('div', { key: index, style: { marginBottom: '10px', padding: '10px', border: '1px solid #ccc' } },
+                        el(TextControl, {
+                            label: 'Ingredient Slug',
+                            value: ingredient.slug,
+                            onChange: function(value) {
+                                updateIngredient(index, 'slug', value);
+                            }
+                        }),
+                        el(TextControl, {
+                            label: 'Amount',
+                            type: 'number',
+                            value: ingredient.amount,
+                            onChange: function(value) {
+                                updateIngredient(index, 'amount', parseFloat(value) || 0);
+                            }
+                        }),
+                        el(TextControl, {
+                            label: 'Unit',
+                            value: ingredient.unit,
+                            onChange: function(value) {
+                                updateIngredient(index, 'unit', value);
+                            }
+                        }),
+                        el(Button, {
+                            isDestructive: true,
+                            onClick: function() {
+                                removeIngredient(index);
+                            }
+                        }, 'Remove')
+                    );
+                }),
+                el(Button, {
+                    isPrimary: true,
+                    onClick: addIngredient
+                }, 'Add Ingredient')
+            );
+        },
+        save: function(props) {
+            var ingredients = props.attributes.ingredients || [];
+            
+            return el('div', { className: 'kc-recipe-ingredients' },
+                el('ul', {},
+                    ingredients.map(function(ingredient, index) {
+                        return el('li', { key: index },
+                            ingredient.amount + ' ' + ingredient.unit + ' ' + ingredient.slug
+                        );
+                    })
+                )
+            );
+        }
+    });
+    
+    // Блок контролера порцій
+    registerBlockType('kc/portion-controller', {
+        title: 'Portion Controller',
+        icon: 'groups',
+        category: 'widgets',
+        edit: function(props) {
+            return el('div', { className: props.className + ' kc-portion-controller' },
+                el('h3', {}, 'Portion Controller'),
+                el('div', { className: 'kc-portions' },
+                    el(Button, { 
+                        className: 'kc-portion-btn',
+                        variant: 'primary'
+                    }, '1x'),
+                    el(Button, { 
+                        className: 'kc-portion-btn',
+                        variant: 'secondary'
+                    }, '2x'),
+                    el(Button, { 
+                        className: 'kc-portion-btn',
+                        variant: 'secondary'
+                    }, '3x')
+                )
+            );
+        },
+        save: function(props) {
+            return el('div', { className: 'kc-portion-controller' },
+                el('div', { className: 'kc-portions' },
+                    el('button', { 
+                        className: 'kc-portion-btn',
+                        'data-multiplier': '1'
+                    }, '1x'),
+                    el('button', { 
+                        className: 'kc-portion-btn',
+                        'data-multiplier': '2'
+                    }, '2x'),
+                    el('button', { 
+                        className: 'kc-portion-btn',
+                        'data-multiplier': '3'
+                    }, '3x')
+                )
+            );
+        }
+    });
+})(window.wp);
diff --git a/assets/js/frontend.js b/assets/js/frontend.js
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/assets/js/frontend.js
@@ -0,0 +1,45 @@
+document.addEventListener('DOMContentLoaded', function() {
+    // Обробка кліків по кнопках порцій
+    document.querySelectorAll('.kc-portion-btn').forEach(function(button) {
+        button.addEventListener('click', function() {
+            var multiplier = parseFloat(this.getAttribute('data-multiplier')) || 1;
+            
+            // Знаходимо батьківський контейнер рецепта
+            var recipeContainer = this.closest('.wp-block-kc-recipe-ingredients') || 
+                                 document.querySelector('.kc-recipe-ingredients');
+            
+            if (recipeContainer) {
+                // Оновлюємо всі інгредієнти
+                var ingredientItems = recipeContainer.querySelectorAll('li');
+                ingredientItems.forEach(function(item) {
+                    var text = item.textContent;
+                    // Тут потрібно реалізувати логіку множення
+                    // Це базова реалізація - потрібно адаптувати залежно від формату
+                    var newText = kc_multiplyIngredientAmount(text, multiplier);
+                    item.textContent = newText;
+                });
+            }
+        });
+    });
+});
+
+function kc_multiplyIngredientAmount(text, multiplier) {
+    // Проста реалізація - потрібно адаптувати залежно від формату тексту
+    // Припустимо формат: "2 шт яйця"
+    var match = text.match(/^(\d+(?:\.\d+)?)\s+(.+)$/);
+    if (match) {
+        var amount = parseFloat(match[1]);
+        var rest = match[2];
+        var newAmount = amount * multiplier;
+        return newAmount + ' ' + rest;
+    }
+    return text;
+}
