diff --git a/includes/database.php b/includes/database.php
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/includes/database.php
@@ -0,0 +1,56 @@
+<?php
+if (!defined('ABSPATH')) {
+    exit;
+}
+
+function kc_create_database_tables() {
+    global $wpdb;
+    
+    $table_name = $wpdb->prefix . 'kc_recipe_ingredients';
+    
+    $charset_collate = $wpdb->get_charset_collate();
+    
+    $sql = "CREATE TABLE $table_name (
+        id mediumint(9) NOT NULL AUTO_INCREMENT,
+        recipe_post_id bigint(20) NOT NULL,
+        ingredient_id bigint(20) NOT NULL,
+        amount decimal(10,4) NOT NULL,
+        unit_text varchar(50) NOT NULL,
+        PRIMARY KEY (id),
+        KEY recipe_post_id (recipe_post_id),
+        KEY ingredient_id (ingredient_id)
+    ) $charset_collate;";
+    
+    require_once(ABSPATH . 'wp-admin/includes/upgrade.php');
+    dbDelta($sql);
+}
+
+function kc_save_recipe_ingredients_data($recipe_post_id, $ingredients_data) {
+    global $wpdb;
+    
+    $table_name = $wpdb->prefix . 'kc_recipe_ingredients';
+    
+    // Очищуємо старі дані для цього рецепта
+    $wpdb->delete($table_name, array('recipe_post_id' => $recipe_post_id));
+    
+    // Зберігаємо нові дані
+    foreach ($ingredients_data as $ingredient) {
+        $wpdb->insert(
+            $table_name,
+            array(
+                'recipe_post_id' => $recipe_post_id,
+                'ingredient_id' => $ingredient['ingredient_id'],
+                'amount' => $ingredient['amount'],
+                'unit_text' => $ingredient['unit_text']
+            ),
+            array('%d', '%d', '%f', '%s')
+        );
+    }
+}
+
+function kc_get_recipe_ingredients($recipe_post_id) {
+    global $wpdb;
+    
+    $table_name = $wpdb->prefix . 'kc_recipe_ingredients';
+    
+    return $wpdb->get_results($wpdb->prepare(
+        "SELECT * FROM $table_name WHERE recipe_post_id = %d",
+        $recipe_post_id
+    ));
+}
